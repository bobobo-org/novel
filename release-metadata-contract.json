{
  "schemaVersion": "p24b-release-metadata-contract-v1",
  "provenanceSchemaVersion": "p24b-rc6.1-build-provenance-v1",
  "allowedProvenanceSchemaVersions": [
    "p24b-rc6.1-build-provenance-v1",
    "p21-build-provenance-v1"
  ],
  "provenanceHashAlgorithm": "sha256",
  "allowedProvenanceSources": [
    "vercel_git_commit_sha",
    "explicit_build_commit",
    "git_head"
  ],
  "allowedArchitectureStages": [
    "P1.5",
    "P2",
    "P2.1",
    "P2.1 RC",
    "P2.3 RC",
    "P2.4A RC",
    "P2.4B RC"
  ],
  "releaseTagPattern": "^novel-ai-(?:p21|p23|p24a|p24b)-[a-z0-9-]+$",
  "releaseRevisionPattern": "^rc[0-9]+(?:\\.[0-9]+)*$",
  "releaseBuildPattern": "^rc[0-9]+(?:\\.[0-9]+)*\\+[0-9a-f]{40}$",
  "releaseBaseCommitPattern": "^[0-9a-f]{40}$",
  "consumerReleasePattern": "^p(?:1\\.5|2(?:\\.[0-9]+[a-z]?)*)(?:-[a-z0-9]+(?:\\.[a-z0-9]+)*)*$",
  "allowedGitCommitSignatures": [
    "unsigned",
    "verified"
  ],
  "buildTimeFormat": "iso-8601"
}
