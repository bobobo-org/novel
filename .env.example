# Copy to .env and fill in real values. .env is gitignored.
# Deployment credentials, management tokens, and the two stable Public Lounge
# runtime keys below are configured as GitHub repository secrets for CI.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes encoded as base64url (43 characters). Server-only; required
# to recover the same management token for a retried public-lounge publish.
# GitHub Actions is the stable escrow. Each main deployment synchronizes the
# same value into a write-only sensitive Vercel Production variable.
PUBLIC_LOUNGE_IDEMPOTENCY_ENCRYPTION_KEY=
# Independent 32 random bytes encoded as base64url (43 characters). Server-only;
# HMACs Vercel's trusted client-IP header before any durable quota write.
# Use an independent GitHub Actions secret; deployment applies the same
# write-only sensitive Vercel treatment without rotating it across pushes.
PUBLIC_LOUNGE_RATE_IDENTITY_HMAC_KEY=

# Reader interactions stay disabled until migration 027, exact production Auth
# redirect, owner lifecycle, and the documented two-account self-test are live.
# The anon key is publishable; the service-role key must remain server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Expected only after apply/check succeeds: public_lounge_interactions_v1_027
PUBLIC_LOUNGE_INTERACTIONS_MIGRATION_VERSION=
# Set only after the real self-test: public_lounge_interactions_runtime_v1
PUBLIC_LOUNGE_INTERACTIONS_ACTIVATION_VERSION=
PUBLIC_LOUNGE_INTERACTIONS_ENABLED=0

# BytePlus LAS Seedance 2.5 — server-side only. Never use a NEXT_PUBLIC_ key.
# The official API contract is implemented, but a credential alone must not enable paid execution.
# Production also requires owner-isolated durable jobs and private validated MP4 storage.
BYTEPLUS_LAS_API_KEY=
BYTEPLUS_LAS_BASE_URL=https://operator.las.ap-southeast-1.bytepluses.com
BYTEPLUS_SEEDANCE_MODEL=dreamina-seedance-2-5-260628

# Novel Video Engine self-hosted GPU worker wrapper — server-side only.
# The worker wraps an allowlisted model/workflow; it is not a Seedance clone. In production use HTTPS.
NOVEL_VIDEO_WORKER_BASE_URL=
NOVEL_VIDEO_WORKER_TOKEN=
NOVEL_VIDEO_WORKER_MODEL=
# Development only: permits http://localhost or http://127.0.0.1 when explicitly set to 1.
NOVEL_VIDEO_WORKER_ALLOW_INSECURE_LOCAL=0

# Optional external text AI. Closed-only remains the default; each external request also needs
# a one-time browser consent. Keys are read only on the server and never use NEXT_PUBLIC_ names.
# Fail closed on public deployments: credentials alone never enable paid execution. Keep this at
# 0 or unset until authenticated accounts, tenant isolation, persistent per-user quotas, and an
# enforced server-side cost cap are all implemented and covered by Production governance.
EXTERNAL_AI_PUBLIC_EXECUTION_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL_ID=
GEMINI_API_KEY=
GEMINI_MODEL_ID=
XAI_API_KEY=
XAI_MODEL_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=

# One optional OpenAI-compatible HTTPS gateway (OpenRouter, Groq, vLLM, LiteLLM, etc.).
EXTERNAL_AI_COMPATIBLE_BASE_URL=
EXTERNAL_AI_COMPATIBLE_API_KEY=
EXTERNAL_AI_COMPATIBLE_MODEL_ID=
EXTERNAL_AI_COMPATIBLE_API_KEY_HEADER=Authorization
EXTERNAL_AI_COMPATIBLE_API_KEY_SCHEME=Bearer
# Development only: permits an explicit local HTTP compatible endpoint.
EXTERNAL_AI_ALLOW_INSECURE_LOCAL_ENDPOINT=0

# Public web research always returns candidate rules only. Cross-user shared-library
# publication is an operator-only action and requires both values plus an admin token
# of at least 32 bytes. Keep disabled on ordinary public deployments; never expose the
# token through NEXT_PUBLIC_ variables.
WEB_DISTILL_SHARED_PUBLISH_ENABLED=0
WEB_DISTILL_SHARED_PUBLISH_ADMIN_TOKEN=

# Google Gemini — server-side only. Accepted by the guarded external connector;
# retired legacy cloud routes never use it.
GOOGLE_GENERATIVE_AI_API_KEY=

# Cloud-only novel AI backend. Never put these values in frontend code.
AI_API_KEY=
AI_PROVIDER=openai-compatible
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions
DATABASE_URL=
ALLOWED_ORIGINS=https://novel-orcin.vercel.app,http://localhost:3000
APP_ENV=development
ADMIN_TOKEN=
