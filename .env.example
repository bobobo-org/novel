# Copy to .env and fill in real values. .env is gitignored.
# These values should also be configured as GitHub repository secrets for CI.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# BytePlus LAS Seedance 2.5 — server-side only. Never use a NEXT_PUBLIC_ key.
# The endpoint and model are allowlisted in code; changing either value makes the runtime fail closed.
# An API key alone does not enable paid generation: a durable job store and validated private MP4
# artifact store must also be implemented before /api/media/video/health reports configured=true.
BYTEPLUS_LAS_API_KEY=
BYTEPLUS_LAS_BASE_URL=https://operator.las.ap-southeast-1.bytepluses.com
BYTEPLUS_SEEDANCE_MODEL=dreamina-seedance-2-5-260628

# Google Gemini — server-side only (used by app/api/generate). Also set in Vercel env.
GOOGLE_GENERATIVE_AI_API_KEY=

# Cloud-only novel AI backend. Never put these values in frontend code.
AI_API_KEY=
AI_PROVIDER=google
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions
DATABASE_URL=
ALLOWED_ORIGINS=https://novel-orcin.vercel.app,http://localhost:3000
APP_ENV=development
ADMIN_TOKEN=
